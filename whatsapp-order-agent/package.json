{
  "name": "whatsapp-order-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-vendor WhatsApp AI ordering agent for restaurants (WhatsApp Cloud API + Claude Haiku 5.5)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "chat": "tsx --env-file-if-exists=.env src/cli/chat.ts",
    "vendors:check": "tsx src/cli/check-vendors.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
