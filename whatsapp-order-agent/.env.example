# ---- Server ----
PORT=3000
# Public https address of this server (used in kitchen screen links)
PUBLIC_URL=https://your-server.example.com

# ---- Claude ----
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=low

# ---- Meta / WhatsApp (one Meta app for all vendors) ----
# Any random text; type the same text in Meta > WhatsApp > Configuration > Verify token
WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-string
# Meta app > Settings > Basic > App secret
META_APP_SECRET=
GRAPH_API_VERSION=v23.0

# ---- Per vendor (names come from each vendors/*.json file) ----
# WhatsApp access token (permanent System User token from the vendor's Business portfolio)
WA_TOKEN_DEMO_PIZZA=
WA_TOKEN_DEMO_FASTFOOD=
# Secret for the kitchen/rider screen link: long random text, different per vendor
OPS_KEY_DEMO_PIZZA=
OPS_KEY_DEMO_FASTFOOD=
# Owner portal key: the shop owner edits menu/timings at /o/<vendor>?key=<this>
OWNER_KEY_DEMO_PIZZA=
OWNER_KEY_DEMO_FASTFOOD=
# Secret for the shared rider page link (only vendors with "riderKeyEnv")
RIDER_KEY_DEMO_PIZZA=

# ---- Admin panel for you: https://<domain>/admin?key=<ADMIN_KEY> (empty = off) ----
ADMIN_KEY=

# ---- Optional: voice notes (any OpenAI-compatible transcription API, e.g. Groq) ----
# STT_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
# STT_API_KEY=
# STT_MODEL=whisper-large-v3

# ---- Storage ----
DB_PATH=data/agent.db

# ---- Server domain for HTTPS (docker compose) ----
# No domain? Use your server IP with dashes + .sslip.io, e.g. 140-238-1-2.sslip.io
DOMAIN=

# ---- Usage meter rates (estimates; update when Meta/Anthropic prices change) ----
# RATE_USD_TO_PKR=280
# RATE_WA_SERVICE_USD=0.015
# RATE_WA_UTILITY_USD=0.015
# RATE_WA_FREE_PER_MONTH=1000
# RATE_AI_INPUT_USD=0.1
# RATE_AI_CACHE_READ_USD=0.01
# RATE_AI_CACHE_WRITE_USD=0.2
# RATE_AI_OUTPUT_USD=0.5

# ---- Your business (printed on vendor invoices) ----
BUSINESS_NAME=Your Business Name
BUSINESS_CONTACT=WhatsApp +92 300 0000000

# ---- Daily database backup ----
# BACKUP_DIR=data/backups
# BACKUP_KEEP=14
# BACKUP_TIME=05:00

# ---- Spam protection: messages per customer per hour (0 = off) ----
CUSTOMER_MESSAGES_PER_HOUR=30
