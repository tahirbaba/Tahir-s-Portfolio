# ---- Server ----
PORT=3000
# Public https address of this server (used in kitchen screen links)
PUBLIC_URL=https://your-server.example.com

# ---- Claude ----
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=low

# ---- Meta / WhatsApp (one Meta app for all vendors) ----
# Any random text; type the same text in Meta > WhatsApp > Configuration > Verify token
WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-string
# Meta app > Settings > Basic > App secret
META_APP_SECRET=
GRAPH_API_VERSION=v23.0

# ---- Per vendor (names come from each vendors/*.json file) ----
# WhatsApp access token (permanent System User token from the vendor's Business portfolio)
WA_TOKEN_DEMO_PIZZA=
WA_TOKEN_DEMO_FASTFOOD=
# Secret for the kitchen/rider screen link: long random text, different per vendor
OPS_KEY_DEMO_PIZZA=
OPS_KEY_DEMO_FASTFOOD=

# ---- Admin panel for you: https://<domain>/admin?key=<ADMIN_KEY> (empty = off) ----
ADMIN_KEY=

# ---- Optional: voice notes (any OpenAI-compatible transcription API, e.g. Groq) ----
# STT_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
# STT_API_KEY=
# STT_MODEL=whisper-large-v3

# ---- Storage ----
DB_PATH=data/agent.db

# ---- Server domain for HTTPS (docker compose) ----
# No domain? Use your server IP with dashes + .sslip.io, e.g. 140-238-1-2.sslip.io
DOMAIN=
